{
  "name": "mdtool-ai-worker",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.35.0",
    "json-rpc-2.0": "^1.7.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^6.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "bin": "dist/index.js",
  "pkg": {
    "targets": ["node22-macos-arm64", "node22-macos-x64", "node22-win-x64"],
    "outputPath": "dist-bin",
    "assets": ["package.json", "dist/**/*"]
  }
}
